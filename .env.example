# LLM
ANTHROPIC_AUTH_TOKEN=__REPLACE_ME__
ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
ANTHROPIC_DEFAULT_HAIKU_MODEL=MiniMax-M3
ANTHROPIC_DEFAULT_SONNET_MODEL=MiniMax-M3
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3
USE_MOCK_LLM=false

# Database
DATABASE_URL=postgresql://adagent:__REPLACE_ME__@localhost:5432/adagentflow
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=10
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=30000
DATABASE_AUTO_CREATE=true

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_IDEMPOTENT_TTL=86400
REDIS_EXECUTION_LOCK_TTL=300

# RabbitMQ
RABBITMQ_URL=amqp://adagent:__REPLACE_ME__@localhost:5672/adagentflow
RABBITMQ_PREFETCH=8

# Workflow
MAX_RETRY_COUNT=3
RETRY_DELAYS=0,5,15
DEAD_LETTER_THRESHOLD=3

# Transactional Outbox
OUTBOX_POLL_INTERVAL=1.0
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=20
OUTBOX_LOCK_TIMEOUT=60

# API
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Observability
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LOG_LEVEL=INFO
LOG_FORMAT=json
SERVICE_NAME=adagentflow
WORKER_SHUTDOWN_TIMEOUT=30
