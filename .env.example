# LLM (minimax responses 协议)
# 变量名沿用 anthropic_* 以兼容历史，但实际是 minimax API key
ANTHROPIC_AUTH_TOKEN=eyJhbGciOi...   # 从 https://platform.minimaxi.com 拿到
ANTHROPIC_BASE_URL=https://api.minimaxi.com  # 路径内部会补 /v1/responses
ANTHROPIC_DEFAULT_HAIKU_MODEL=MiniMax-M3
ANTHROPIC_DEFAULT_SONNET_MODEL=MiniMax-M3
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3

# 数据库
DATABASE_URL=postgresql://adagent:adagent_secret_2026@localhost:5432/adagentflow
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_IDEMPOTENT_TTL=86400

# RabbitMQ
RABBITMQ_URL=amqp://adagent:adagent_secret_2026@localhost:5672/adagentflow
RABBITMQ_PREFETCH=8

# 任务配置
MAX_RETRY_COUNT=3
RETRY_DELAYS=0,5,15
DEAD_LETTER_THRESHOLD=3

# Langfuse
LANGFUSE_ENABLED=true
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx

# 业务开关
USE_MOCK_LLM=true
USE_OLLAMA_FALLBACK=false
OLLAMA_BASE_URL=http://localhost:11434

# 日志
LOG_LEVEL=INFO
